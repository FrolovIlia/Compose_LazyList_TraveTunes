<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    app:cardCornerRadius="8dp"
    android:layout_marginBottom="@dimen/spacing_8"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/image"
            android:layout_width="150dp"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            tools:src="@drawable/ivanovo_city"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/cityName"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            tools:text="Иваново"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#000000"
            android:textSize="20sp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/image"
            app:layout_constraintTop_toTopOf="@id/image" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/cityDescription"
            android:layout_width="0dp"
            android:layout_height="0dp"
            tools:text="Город административного значения в центральной части России. Нередко Иваново называют – «город невест», а также «родина Первого Совета», «ситцевый край» и «текстильная столица России». "
            app:layout_constraintTop_toBottomOf="@id/cityName"
            android:textColor="#555555"
            android:ellipsize="end"
            android:layout_marginBottom="4dp"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintBottom_toTopOf="@id/moveInCity"
            app:layout_constraintEnd_toEndOf="@id/cityName"
            app:layout_constraintStart_toStartOf="@id/cityName" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/moveInCity"
            android:layout_width="197dp"
            android:layout_height="match_parent"
            android:backgroundTint="@color/main_blue"
            android:text="@string/point_item_info_show"
            app:cornerRadius="40dp"
            android:layout_marginBottom="4dp"
            android:textAllCaps="false"
            app:layout_constraintStart_toStartOf="@id/cityName"
            app:layout_constraintEnd_toEndOf="@id/cityName"
            app:layout_constraintBottom_toBottomOf="@id/image"
             />

    </androidx.constraintlayout.widget.ConstraintLayout>


